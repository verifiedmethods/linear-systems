# Runs the official checks on every push and keeps the verification report as a
# downloadable artifact (Actions tab -> latest run -> Artifacts).
name: verify
on:
  push:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  verify:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
      - uses: astral-sh/setup-uv@1c37ad07a6a961277cf70c0d37d6f313000f5884 # v10.3.0
      - name: Use the official checks for version @VERSION@
        if: ${{ !contains('@VERSION@', 'dev') }}
        run: |
          curl -fsSL -o vm-official.zip "https://github.com/verifiedmethods/linear-systems/releases/download/v@VERSION@/vm-official-@VERSION@.zip"
          rm -rf vm verify.py
          unzip -q vm-official.zip
      - name: Run the checks
        run: uv run --no-project --python 3.12 --with-requirements requirements.txt python verify.py --ci
      - name: Keep the verification report
        if: always()
        uses: actions/upload-artifact@cf430e030ddbb5b0abf93d22962f4752f3646cd9 # v7.0.2
        with:
          name: verification-report
          path: report/
